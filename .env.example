# postgres database url
# NUXT_DB_URL=postgres://username:password@localhost:5432/db_name
NUXT_DB_HOST=localhost
NUXT_DB_PORT=5432
NUXT_DB_USERNAME=postgres
NUXT_DB_PASSWORD=postgres
NUXT_DB_DATABASE_NAME=sge_lims_db
NUXT_DB_SSL=false
NUXT_DB_SSL_CA=
NUXT_DB_SSL_CA_PATH=

NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_APP_URL=http://localhost:3000

# jwt secret
NUXT_AUTH_JWT_ACCESS_TOKEN_EXPIRES_IN=5m
NUXT_AUTH_JWT_REFRESH_TOKEN_EXPIRES_IN=10m
NUXT_AUTH_JWT_ACCESS_TOKEN_SECRET=access-token-secret-base64
NUXT_AUTH_JWT_REFRESH_TOKEN_SECRET=refresh-token-secret-base64

NUXT_SESSION_PASSWORD=password-with-at-least-32-characters
